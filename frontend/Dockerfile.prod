# === Étape 1 : Build du frontend ===
FROM node:20-alpine AS build
WORKDIR /app

# Copier package.json et package-lock.json
COPY package*.json ./

# Installer les dépendances
RUN npm ci --legacy-peer-deps

# Copier le reste du code
COPY . .

# Variables d'environnement pour Vite (URL complètes en prod)
ARG VITE_API_URL=https://frontend-production-a1c6.up.railway.app

ENV VITE_API_URL=$VITE_API_URL

# Build de l'application
RUN npm run build

# === Étape 2 : Serveur Nginx ===
FROM nginx:alpine

# Installer certificats CA pour proxy HTTPS
RUN apk add --no-cache ca-certificates && update-ca-certificates

# Supprimer la conf Nginx par défaut
RUN rm -f /etc/nginx/conf.d/default.conf

# Copier la conf frontend personnalisée
COPY default.prod.conf /etc/nginx/conf.d/default.conf

# Copier le build frontend
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
