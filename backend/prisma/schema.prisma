generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id             Int      @id @default(autoincrement())
  nom            String
  prenom         String
  email          String   @unique
  hash           String
  cle_invisible  String   @unique
  role           String   @default("utilisateur")
  billets        Billet[]
  paiements      Paiement[]
}

model Evenement {
  id                    Int      @id @default(autoincrement())
  nom                   String
  date                  DateTime
  lieu                  String
  nombre_places_dispo   Int
  billets               Billet[]
}

model TypeBillet {
  id                  Int      @id @default(autoincrement())
  nom                 String
  description         String?
  prix                Int
  accessibilite_PMR   Boolean  @default(false)
  nombre_places       Int
  billets             Billet[]
}

model Offre {
  id                Int      @id @default(autoincrement())
  nom               String
  description       String?
  nombre_personnes  Int
  visible           Boolean  @default(true)
}

model Paiement {
  id             Int      @id @default(autoincrement())
  montant        Int
  methode        String
  date           DateTime
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id])
  id_utilisateur Int
  billets        Billet[]
}

model Billet {
  id               Int      @id @default(autoincrement())
  prix             Int
  cle_achat        String
  cle_invisible    String?
  utilisateur      Utilisateur @relation(fields: [id_utilisateur], references: [id])
  id_utilisateur   Int
  evenement        Evenement   @relation(fields: [id_evenement], references: [id])
  id_evenement     Int
  typeBillet       TypeBillet  @relation(fields: [id_type_billet], references: [id])
  id_type_billet   Int
  paiement         Paiement    @relation(fields: [id_paiement], references: [id])
  id_paiement      Int
  validations      Validation[]
}

model Validation {
  id                 String   @id @default(uuid())
  heure_scan         DateTime @default(now())
  employe_validateur String?
  etat_validite      String   @default("non scanné")
  billet             Billet   @relation(fields: [id_billet], references: [id])
  id_billet          Int
}
