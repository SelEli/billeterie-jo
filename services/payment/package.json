{
  "name": "payment-service",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:cov": "NODE_ENV=test jest --coverage --runInBand",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "morgan": "^1.3.2",
    "uuid": "^11.1.0",
    "winston": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "jest": "^20.0.4",
    "node-mocks-http": "^1.17.2",
    "nodemon": "^1.4.1",
    "prettier": "^3.3.1",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
