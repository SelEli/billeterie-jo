{
  "name": "user-service",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/index.js",

    "test": "NODE_ENV=test jest --runInBand",
    "test:cov": "NODE_ENV=test jest --coverage --runInBand",

    "test:all": "NODE_ENV=test jest tests/index.js --runInBand",
    "test:auth": "NODE_ENV=test jest tests/auth/index.js --runInBand",
    "test:user": "NODE_ENV=test jest tests/user/index.js --runInBand",
    "test:role": "NODE_ENV=test jest tests/role/index.js --runInBand",

    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.0",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.1",
    "prisma": "^5.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.0"
  }
