# 🌐 Port du serveur Express
PORT=3001

# 🛢️ Base de données PostgreSQL (via Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/auth_db

# 🔐 JWT — Token principal pour connexion utilisateur
JWT_SECRET=your_jwt_secret_here

# 🗝️ Clé privée invisible utilisée pour générer la 1re partie du billet
CLEF_SIGNATURE_SECRET=internal_signature_key

# 🧠 Redis — utilisé pour session, cache temporaire, etc.
REDIS_URL=redis://localhost:6379

# 📡 Kafka — publication d'événements (inscription, login, etc.)
KAFKA_BROKER=localhost:9092

# 📋 Identité du service pour logs et traçabilité
SERVICE_NAME=auth-service

# 📌 Environnement d'exécution
NODE_ENV=development
