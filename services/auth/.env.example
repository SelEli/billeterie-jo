# 🌐 Port du serveur Express
PORT=3000

# 🛢️ Base de données PostgreSQL (via Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/your_database

# 🔐 JWT pour authentification des utilisateurs
JWT_SECRET=your_jwt_secret_here

# 🗝️ Clé de signature invisible (tokens privés, clés internes)
CLEF_SIGNATURE_SECRET=your_signature_secret_here

# 💳 Clé secrète Stripe (si paiement activé)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# 🧠 Cache Redis
REDIS_URL=redis://localhost:6379

# 📡 Brokers Kafka (events, microservices)
KAFKA_BROKERS=localhost:9092

# 📋 Nom du service pour logs/monitoring/event sourcing
SERVICE_NAME=user-service

# 📌 Environnement d’exécution
NODE_ENV=development
