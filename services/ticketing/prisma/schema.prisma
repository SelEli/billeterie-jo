// ----------------------
// Prisma configuration
// ----------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// Énumérations
// ----------------------

enum TicketStatus {
  RESERVED
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
}

// ----------------------
// Modèles
// ----------------------

model Event {
  id         Int       @id @default(autoincrement())
  label      String
  date       DateTime
  location   String
  category   String?               // Optionnel : "ceremony", "match", etc.
  capacity   Int?                  // Nombre total de places (optionnel, pour limiter tickets)
  status     EventStatus?          // DRAFT / PUBLISHED / SOLD_OUT / CANCELLED
  description String?              // Présentation détaillée
  imageUrl   String?               // URL pour illustration
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?              // Soft delete

  // Relations
  tickets    Ticket[]               // Tickets liés à cet événement
  offers     Offer[]                // Offres associées à cet événement
}

model Offer {
  id         Int       @id @default(autoincrement())
  label      String
  discount   Float
  active     Boolean   @default(true)
  validFrom  DateTime?               // Début de validité
  validTo    DateTime?               // Fin de validité
  quota      Int?                    // Nombre max de tickets

  // Relation vers Event
  eventId    Int?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Relation inverse vers Ticket
  tickets    Ticket[]
}

model Ticket {
  id        Int          @id @default(autoincrement())
  price     Float
  zone      String?
  status    TicketStatus @default(RESERVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  secretKey String       @unique
  signature String?      @unique

  // Référence utilisateur (pas de relation Prisma vers User)
  userId    Int

  // Relations vers Event et Offer
  eventId   Int?
  offerId   Int?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offer     Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
}
