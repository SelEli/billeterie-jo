// ----------------------
// Prisma configuration
// ----------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// Enumérations
// ----------------------

enum Role {
  VISITOR
  USER
  ADMIN
  EMPLOYEE
  AGENT
}

enum TicketStatus {
  RESERVED
  VALID
  USED
  CANCELLED
  EXPIRED
}

// ----------------------
// Modèles
// ----------------------

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  hash            String
  firstName       String?
  lastName        String?
  birthDate       DateTime?
  role            Role      @default(VISITOR)
  invisibleKey    String
  lastLogin       DateTime?
  isBlacklisted   Boolean   @default(false)
  blacklistReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets         Ticket[]  // Relation vers Ticket
}

model Event {
  id         Int       @id @default(autoincrement())
  label      String
  date       DateTime
  location   String
  category   String?                // Optionnel : "ceremony", "match", etc.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?              // Soft delete

  tickets    Ticket[]               // Tickets liés à cet événement
  offers     Offer[]                // 🔧 Relation inverse vers Offer
}

model Offer {
  id         Int       @id @default(autoincrement())
  label      String
  discount   Float
  active     Boolean   @default(true)
  targetRole Role
  validFrom  DateTime?             // Optionnel : début de validité de l’offre
  validTo    DateTime?             // Optionnel : fin de validité de l’offre
  quota      Int?                  // Optionnel : nombre max de tickets concernés

  eventId    Int?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets    Ticket[]             // Tickets associés à cette offre
}

model Ticket {
  id        Int          @id @default(autoincrement())
  price     Float
  zone      String?
  status    TicketStatus @default(RESERVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  secretKey String   @unique
  signature String   @unique


  userId    Int?
  eventId   Int?
  offerId   Int?

  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offer     Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
}
