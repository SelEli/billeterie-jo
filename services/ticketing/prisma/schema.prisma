// ----------------------
// Prisma configuration
// ----------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// Énumérations
// ----------------------

enum TicketStatus {
  RESERVED
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
}

// ----------------------
// Modèles
// ----------------------

model Event {
  id          Int       @id @default(autoincrement())
  label       String
  date        DateTime
  location    String
  category    String?               
  capacity    Int?                  
  basePrice   Float     @default(0)   // 🔴 ajouté
  status      EventStatus?          
  description String?              
  imageUrl    String?              
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?             

  zones       String[]               // 🟠 ajouté

  // Relations
  tickets     Ticket[]               
  offers      Offer[]                // 1‑N actuelle
  sharedOffers Offer[] @relation("EventsOnOffers") // 🟠 future N‑N
}

model Offer {
  id        Int       @id @default(autoincrement())
  label     String
  discount  Float
  active    Boolean   @default(true)
  validFrom DateTime?               
  validTo   DateTime?               
  quota     Int?                    

  // Relation vers Event (1‑N actuelle)
  eventId   Int?
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Relation many-to-many (future)
  events    Event[]   @relation("EventsOnOffers")

  // Relation inverse vers Ticket
  tickets   Ticket[]
}

model Ticket {
  id        Int          @id @default(autoincrement())
  price     Float
  zone      String?                          // 🟠 gardé pour transition
  status    TicketStatus @default(RESERVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  secretKey String       @unique
  signature String?      @unique

  userId    Int

  // Relations vers Event et Offer
  eventId   Int                               // 🔴 rendu obligatoire
  offerId   Int?
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offer     Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
}
