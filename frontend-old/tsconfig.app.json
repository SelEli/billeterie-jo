{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "useDefineForClassFields": true,

    /* JSX React 17+ */
    "jsx": "react-jsx",

    /* Types React pour résoudre JSX.Element */
    "types": ["react", "react-dom"],

    /* Libs complètes pour JSX + DOM + ESNext */
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext"],

    /* Alias pour imports */
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@shared/*": ["../shared/*"]
    },

    /* Optionnel : si tu veux supprimer les types non utilisés à l'emit */
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
